                {
                    "name": "Agent Heartbeat Gateway",
                    "item": [
                        {
                            "name": "Submit Heartbeat",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "X-API-Key",
                                        "value": "{{worker_api_key}}"
                                    },
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"cpu_usage\": 12.5,\n  \"ram_usage\": 45.2,\n  \"disk_usage\": 60.1,\n  \"network_rx\": 10240,\n  \"network_tx\": 5120,\n  \"docker_status\": \"running\",\n  \"nomad_status\": \"running\",\n  \"judge_status\": \"running\",\n  \"running_jobs\": 2,\n  \"queue_length\": 0,\n  \"total_requests\": 150,\n  \"avg_runtime\": 250.5,\n  \"retry_count\": 0,\n  \"worker_version\": \"1.0.0\",\n  \"uptime\": 3600,\n  \"hostname\": \"worker-node-1\",\n  \"nomad_node_id\": \"nomad-uuid-placeholder\"\n}"
                                },
                                "url": {
                                    "raw": "{{dashboard_url}}/api/heartbeat",
                                    "host": [
                                        "{{dashboard_url}}"
                                    ],
                                    "path": [
                                        "api",
                                        "heartbeat"
                                    ]
                                }
                            }
                        }
